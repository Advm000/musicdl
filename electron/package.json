{
  "name": "music-dl",
  "version": "2.9.0",
  "description": "Music DL — Téléchargeur de musique pour Windows",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Advm000/musicdl"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.musicdl.app",
    "productName": "Music DL",
    "copyright": "Music DL",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../dist/MusicDL",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "artifactName": "MusicDL-Setup.exe",
    "publish": {
      "provider": "github",
      "owner": "Advm000",
      "repo": "musicdl"
    },
    "win": {
      "icon": "icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music DL",
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.4"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
